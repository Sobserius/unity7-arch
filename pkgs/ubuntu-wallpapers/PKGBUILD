# Maintainer: Charlie <dev.charlie@akao.au>

pkgname=ubuntu-wallpapers
# 17.04 (zesty) is the last Ubuntu release that shipped Unity 7 by default, so
# its wallpaper is the one that matches this desktop. newer releases replaced it
# with the gnome era art, and only 17.04 still carries the unity wallpaper.
pkgver=17.04.1
pkgrel=1
pkgdesc='the zesty (17.04) ubuntu desktop wallpaper and its gnome-background-properties entry'
arch=('any')
url='https://launchpad.net/ubuntu/+source/ubuntu-wallpapers'
license=('CC-BY-SA-3.0')
makedepends=('python' 'libarchive')
# not the launchpad tree, that one is an 890mb orig tarball of every community
# wallpaper ubuntu has ever shipped. this binary is just the default ones.
# zesty is archived, so it lives on old-releases rather than archive.ubuntu.com
source=("https://old-releases.ubuntu.com/ubuntu/pool/main/u/${pkgname}/${pkgname}_${pkgver}-0ubuntu1_all.deb")
sha256sums=('6908b9eceac95861258434c06afe81c647047b92cc0e8c2410b85c263f454ac9')
noextract=("${pkgname}_${pkgver}-0ubuntu1_all.deb")

package() {
  local deb="${pkgname}_${pkgver}-0ubuntu1_all.deb" data
  data=$(bsdtar -tf "$deb" | grep -m1 '^data\.tar')
  bsdtar -xOf "$deb" "$data" | bsdtar -xf - -C "${pkgdir}" \
    ./usr/share/backgrounds/warty-final-ubuntu.png \
    ./usr/share/gnome-background-properties/ubuntu-wallpapers.xml \
    ./usr/share/doc/${pkgname}/copyright
  # the greyscale entry points at a png that ships in the separate per release
  # package, drop any entry whose file isn't here so the picker has no dead
  # thumbnails
  python - "${pkgdir}" <<'EOF'
import os, sys
import xml.etree.ElementTree as et
root_dir = sys.argv[1]
path = os.path.join(root_dir, 'usr/share/gnome-background-properties/ubuntu-wallpapers.xml')
tree = et.parse(path)
root = tree.getroot()
for wp in list(root):
    files = [f.text for f in wp if f.tag.startswith('filename')]
    if any(not os.path.exists(root_dir + f) for f in files):
        root.remove(wp)
body = et.tostring(root, encoding='unicode')
with open(path, 'w') as f:
    # keep the doctype, ElementTree drops it and the gnome wp list format declares one
    f.write('<?xml version="1.0" encoding="UTF-8"?>\n'
            '<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">\n' + body + '\n')
EOF
  install -Dm644 "${pkgdir}/usr/share/doc/${pkgname}/copyright" \
    "${pkgdir}/usr/share/licenses/${pkgname}/copyright"
  rm -r "${pkgdir}/usr/share/doc"
}
